{
    "semi": true,
    "singleQuote": true,
    "singleAttributePerLine": false,
    "htmlWhitespaceSensitivity": "css",
    "printWidth": 200,
    "plugins": [
        "prettier-plugin-blade",
        "@prettier/plugin-php"
    ],
    "tabWidth": 4,
    "trailingComma": "none",
    "bladeDirectiveArgSpacing": "none",
    "bladeDirectiveArgSpacingOverrides": [
        "if",
        "elseif",
        "unless",
        "while",
        "for",
        "foreach",
        "forelse",
        "switch",
        "case"
    ],
    "overrides": [
        {
            "files": "**/*.yml",
            "options": {
                "tabWidth": 2
            }
        },
        {
            "files": "**/*.php",
            "options": {
                "parser": "php",
                "singleQuote": true,
                "tabWidth": 4,
                "printWidth": 120,
                "braceStyle": "per-cs"
            }
        },
        {
            "files": [
                "**/*.blade.php"
            ],
            "options": {
                "parser": "blade",
                "tabWidth": 4,
                "printWidth": 200
            }
        }
    ]
}
