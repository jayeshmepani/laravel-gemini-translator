{
    "name": "jayesh/laravel-gemini-translator",
    "description": "An interactive command to extract and generate Laravel translations using Gemini AI.",
    "type": "laravel-package",
    "license": "MIT",
    "keywords": [
        "laravel",
        "laravel-package",
        "translation",
        "translation-generator",
        "translation-extractor",
        "laravel-translator",
        "laravel-localization",
        "laravel-ai",
        "i18n",
        "multilingual",
        "localization",
        "language-files",
        "ai-translator",
        "ai-tools",
        "google-gemini",
        "gemini-ai",
        "artisan-command",
        "composer-package",
        "developer-tools",
        "automation",
        "php"
    ],
    "homepage": "https://github.com/jayeshmepani/laravel-gemini-translator",
    "readme": "README.md",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "authors": [
        {
            "name": "Jayesh Patel",
            "email": "jayeshmepani777@gmail.com",
            "homepage": "https://github.com/jayeshmepani"
        }
    ],
    "support": {
        "issues": "https://github.com/jayeshmepani/laravel-gemini-translator/issues",
        "source": "https://github.com/jayeshmepani/laravel-gemini-translator",
        "docs": "https://jayeshmepani.github.io/laravel-gemini-translator/"
    },
    "funding": [
        {
            "type": "github",
            "url": "https://github.com/sponsors/jayeshmepani"
        }
    ],
    "require": {
        "php": "^8.3",
        "laravel/framework": "^11.0||^12.0||^13.0",
        "google-gemini-php/laravel": "^2.0",
        "spatie/fork": "^1.2"
    },
    "require-dev": {
        "laravel/pint": "^1.29",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.0",
        "orchestra/testbench": "^9.0 || ^10.0",
        "phpstan/extension-installer": "^1.3",
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-mockery": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^11.0",
        "rector/rector": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Jayesh\\LaravelGeminiTranslator\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Jayesh\\LaravelGeminiTranslator\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Jayesh\\LaravelGeminiTranslator\\TranslationServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {
            "php-http/discovery": true,
            "phpstan/extension-installer": true
        }
    },
    "scripts": {
        "test": "phpunit --do-not-fail-on-warning --do-not-fail-on-phpunit-warning --do-not-fail-on-incomplete --do-not-fail-on-deprecation --do-not-fail-on-phpunit-deprecation",
        "rector": "vendor/bin/rector process",
        "lint": "pint",
        "lint:fix": "pint",
        "lint:check": "pint --test",
        "test:lint": "@lint:check",
        "phpstan": "phpstan analyse --memory-limit=2G",
        "rector:dry": "rector process --dry-run",
        "quality": [
            "@lint:check",
            "@phpstan",
            "@test"
        ]
    }
}